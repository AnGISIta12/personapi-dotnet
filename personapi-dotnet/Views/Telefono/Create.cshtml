@model personapi_dotnet.Models.Entities.Telefono

@{
    ViewData["Title"] = "Crear teléfono";
}

<a class="crumb reveal" asp-action="Index"><i class="ph ph-arrow-left"></i>Volver a teléfonos</a>

<div class="surface form-card reveal" style="--i:1">
    <div class="form-head">
        <span class="icon-tile red"><i class="ph ph-phone"></i></span>
        <div>
            <h2>Nuevo teléfono</h2>
            <p>Completa los datos y elige a su dueño.</p>
        </div>
    </div>
    <form asp-action="Create">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="row">
            <div class="col-md-6 form-group">
                <label asp-for="Num" class="control-label">Número</label>
                <input asp-for="Num" class="form-control" maxlength="15" />
                <span asp-validation-for="Num" class="text-danger"></span>
            </div>
            <div class="col-md-6 form-group">
                <label asp-for="Oper" class="control-label">Operador</label>
                <input asp-for="Oper" class="form-control" />
                <span asp-validation-for="Oper" class="text-danger"></span>
            </div>
            <div class="col-md-6 form-group">
                <label asp-for="Duenio" class="control-label">Dueño</label>
                <select asp-for="Duenio" class="form-control" asp-items="ViewBag.Duenio"></select>
            </div>
        </div>
        <div class="form-actions">
            <input type="submit" value="Crear" class="btn btn-primary" />
            <a class="btn btn-ghost" asp-action="Index">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
