@model personapi_dotnet.Models.Entities.Telefono

@{
    ViewData["Title"] = "Crear";
}

<h1>Crear</h1>

<h4>Telefono</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Num" class="control-label">Numero</label>
                <input asp-for="Num" class="form-control" maxlength="15" />
                <span asp-validation-for="Num" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Oper" class="control-label">Operador</label>
                <input asp-for="Oper" class="form-control" />
                <span asp-validation-for="Oper" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Duenio" class="control-label">Dueño</label>
                <select asp-for="Duenio" class="form-control" asp-items="ViewBag.Duenio"></select>
            </div>
            <div class="form-group mt-2">
                <input type="submit" value="Crear" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Volver a la lista</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
