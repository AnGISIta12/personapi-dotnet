@*
    Vista Telefono/Delete (DELETE - confirmacion)
    Muestra el telefono y pide confirmar el borrado.
    Modelo: Telefono.
    La llama: TelefonoController.Delete(string id) [GET], que no borra nada.
    Envia a: TelefonoController.DeleteConfirmed(string id) [POST], expuesta como
    "Delete" con [ActionName("Delete")].
*@
@model personapi_dotnet.Models.Entities.Telefono

@{
    ViewData["Title"] = "Eliminar teléfono";
}

<a class="crumb reveal" asp-action="Index"><i class="ph ph-arrow-left"></i>Volver a teléfonos</a>

<div class="surface detail-card danger-card reveal" style="--i:1">
    <div class="warning">
        <i class="ph ph-warning"></i>
        <div>
            <strong>¿Seguro que quieres eliminar este teléfono?</strong>
            <span>Esta acción no se puede deshacer.</span>
        </div>
    </div>
    <dl class="detail-list">
        <div class="detail-item">
            <dt>Número</dt>
            <dd>@Html.DisplayFor(model => model.Num)</dd>
        </div>
        <div class="detail-item">
            <dt>Operador</dt>
            <dd>@Html.DisplayFor(model => model.Oper)</dd>
        </div>
        <div class="detail-item">
            <dt>Dueño</dt>
            <dd>@Model.Duenio - @Model.DuenioNavigation.Nombre @Model.DuenioNavigation.Apellido</dd>
        </div>
    </dl>

    @*
        Form POST con token antifalsificacion. El oculto name="id" envia el
        numero (PK) al parametro "string id" de DeleteConfirmed. Telefono es
        tabla hija sin dependientes, asi que se borra directamente.
    *@
    <form asp-action="Delete">
        <input type="hidden" name="id" value="@Model.Num" />
        <div class="form-actions">
            <input type="submit" value="Eliminar" class="btn btn-danger" />
            <a class="btn btn-ghost" asp-action="Index">Cancelar</a>
        </div>
    </form>
</div>
