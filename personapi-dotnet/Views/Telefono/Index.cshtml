@model IEnumerable<personapi_dotnet.Models.Entities.Telefono>

@{
    ViewData["Title"] = "Teléfonos";
}

<div class="page-head reveal">
    <div>
        <h1>Teléfonos</h1>
        <p class="lede">Todos los teléfonos registrados y a quién pertenecen. Desde aquí puedes ver sus datos, editarlos o eliminarlos.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create"><i class="ph ph-plus"></i>Crear nuevo</a>
</div>

<div class="surface reveal" style="--i:1">
    @if (!Model.Any())
    {
        <div class="empty">
            <i class="ph ph-phone"></i>
            <h3>Aún no hay teléfonos</h3>
            <p>Registra el primer teléfono y asígnalo a su dueño.</p>
            <a class="btn btn-primary" asp-action="Create"><i class="ph ph-plus"></i>Crear teléfono</a>
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table class="table app-table">
                <thead>
                    <tr>
                        <th>Número</th>
                        <th>Operador</th>
                        <th>Dueño</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
            @foreach (var item in Model) {
                    <tr>
                        <td class="num">@Html.DisplayFor(modelItem => item.Num)</td>
                        <td><span class="tag red">@Html.DisplayFor(modelItem => item.Oper)</span></td>
                        <td>
                            <span class="who">
                                <span class="avatar">@(string.IsNullOrEmpty(item.DuenioNavigation.Nombre) ? "?" : item.DuenioNavigation.Nombre.Substring(0, 1).ToUpper())</span>
                                <span>@item.Duenio - @item.DuenioNavigation.Nombre @item.DuenioNavigation.Apellido</span>
                            </span>
                        </td>
                        <td class="text-end-cell">
                            <span class="row-actions">
                                <a class="row-action" asp-action="Edit" asp-route-id="@item.Num"><i class="ph ph-pencil-simple"></i>Editar</a>
                                <a class="row-action" asp-action="Details" asp-route-id="@item.Num"><i class="ph ph-eye"></i>Detalles</a>
                                <a class="row-action danger" asp-action="Delete" asp-route-id="@item.Num"><i class="ph ph-trash"></i>Eliminar</a>
                            </span>
                        </td>
                    </tr>
            }
                </tbody>
            </table>
        </div>
    }
</div>
