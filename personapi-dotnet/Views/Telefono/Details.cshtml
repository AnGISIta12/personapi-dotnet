@*
    Vista Telefono/Details (READ - un registro)
    Muestra un telefono y su duenio en modo solo lectura.
    Modelo: Telefono (con DuenioNavigation cargado por Include).
    La llama: TelefonoController.Details(string id) [GET] (/Telefono/Details/{num}).
    No envia formularios; el enlace Editar pasa el numero con asp-route-id.
*@
@model personapi_dotnet.Models.Entities.Telefono

@{
    ViewData["Title"] = "Detalles del teléfono";
}

<a class="crumb reveal" asp-action="Index"><i class="ph ph-arrow-left"></i>Volver a teléfonos</a>

<div class="surface detail-card reveal" style="--i:1">
    <div class="form-head">
        <span class="icon-tile red"><i class="ph ph-phone"></i></span>
        <div>
            <h2>@Html.DisplayFor(model => model.Num)</h2>
            <p>Datos del teléfono</p>
        </div>
    </div>
    <dl class="detail-list">
        <div class="detail-item">
            <dt>Número</dt>
            <dd>@Html.DisplayFor(model => model.Num)</dd>
        </div>
        <div class="detail-item">
            <dt>Operador</dt>
            <dd>@Html.DisplayFor(model => model.Oper)</dd>
        </div>
        <div class="detail-item">
            <dt>Dueño</dt>
            <dd>@Model.Duenio - @Model.DuenioNavigation.Nombre @Model.DuenioNavigation.Apellido</dd>
        </div>
    </dl>
    <div class="form-actions">
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Num"><i class="ph ph-pencil-simple"></i>Editar</a>
        <a class="btn btn-ghost" asp-action="Index">Volver a la lista</a>
    </div>
</div>
