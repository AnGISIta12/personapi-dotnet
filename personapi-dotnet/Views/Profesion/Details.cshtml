@model personapi_dotnet.Models.Entities.Profesion

@{
    ViewData["Title"] = "Detalles de profesión";
}

<a class="crumb reveal" asp-action="Index"><i class="ph ph-arrow-left"></i>Volver a profesiones</a>

<div class="surface detail-card reveal" style="--i:1">
    <div class="form-head">
        <span class="icon-tile yellow"><i class="ph ph-briefcase"></i></span>
        <div>
            <h2>@Html.DisplayFor(model => model.Nom)</h2>
            <p>Datos de la profesión</p>
        </div>
    </div>
    <dl class="detail-list">
        <div class="detail-item">
            <dt>Id</dt>
            <dd>@Html.DisplayFor(model => model.Id)</dd>
        </div>
        <div class="detail-item">
            <dt>Nombre</dt>
            <dd>@Html.DisplayFor(model => model.Nom)</dd>
        </div>
        <div class="detail-item">
            <dt>Descripción</dt>
            <dd>@Html.DisplayFor(model => model.Des)</dd>
        </div>
    </dl>
    <div class="form-actions">
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id"><i class="ph ph-pencil-simple"></i>Editar</a>
        <a class="btn btn-ghost" asp-action="Index">Volver a la lista</a>
    </div>
</div>
