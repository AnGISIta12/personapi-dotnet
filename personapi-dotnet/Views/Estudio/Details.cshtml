@model personapi_dotnet.Models.Entities.Estudio

@{
    ViewData["Title"] = "Detalles";
}

<h1>Detalles</h1>

<div>
    <h4>Estudio</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Persona</dt>
        <dd class="col-sm-10">@Model.CcPer - @Model.CcPerNavigation.Nombre @Model.CcPerNavigation.Apellido</dd>
        <dt class="col-sm-2">Profesion</dt>
        <dd class="col-sm-10">@Model.IdProf - @Model.IdProfNavigation.Nom</dd>
        <dt class="col-sm-2">Fecha</dt>
        <dd class="col-sm-10">@Model.Fecha?.ToString("yyyy-MM-dd")</dd>
        <dt class="col-sm-2">Universidad</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Univer)</dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-idProf="@Model.IdProf" asp-route-ccPer="@Model.CcPer">Editar</a> |
    <a asp-action="Index">Volver a la lista</a>
</div>
