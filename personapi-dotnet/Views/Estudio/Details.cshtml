@model personapi_dotnet.Models.Entities.Estudio

@{
    ViewData["Title"] = "Detalles de estudio";
}

<a class="crumb reveal" asp-action="Index"><i class="ph ph-arrow-left"></i>Volver a estudios</a>

<div class="surface detail-card reveal" style="--i:1">
    <div class="form-head">
        <span class="icon-tile green"><i class="ph ph-graduation-cap"></i></span>
        <div>
            <h2>@Model.IdProfNavigation.Nom</h2>
            <p>Datos del estudio</p>
        </div>
    </div>
    <dl class="detail-list">
        <div class="detail-item">
            <dt>Persona</dt>
            <dd>@Model.CcPer - @Model.CcPerNavigation.Nombre @Model.CcPerNavigation.Apellido</dd>
        </div>
        <div class="detail-item">
            <dt>Profesión</dt>
            <dd>@Model.IdProf - @Model.IdProfNavigation.Nom</dd>
        </div>
        <div class="detail-item">
            <dt>Fecha</dt>
            <dd>@Model.Fecha?.ToString("yyyy-MM-dd")</dd>
        </div>
        <div class="detail-item">
            <dt>Universidad</dt>
            <dd>@Html.DisplayFor(model => model.Univer)</dd>
        </div>
    </dl>
    <div class="form-actions">
        <a class="btn btn-primary" asp-action="Edit" asp-route-idProf="@Model.IdProf" asp-route-ccPer="@Model.CcPer"><i class="ph ph-pencil-simple"></i>Editar</a>
        <a class="btn btn-ghost" asp-action="Index">Volver a la lista</a>
    </div>
</div>
