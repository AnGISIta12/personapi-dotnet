@model personapi_dotnet.Models.Entities.Estudio

@{
    ViewData["Title"] = "Editar estudio";
}

<a class="crumb reveal" asp-action="Index"><i class="ph ph-arrow-left"></i>Volver a estudios</a>

<div class="surface form-card reveal" style="--i:1">
    <div class="form-head">
        <span class="icon-tile green"><i class="ph ph-graduation-cap"></i></span>
        <div>
            <h2>Editar estudio</h2>
            <p>Actualiza la fecha y la universidad. La persona y la profesión no se pueden cambiar.</p>
        </div>
    </div>
    <form asp-action="Edit">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="CcPer" />
        <input type="hidden" asp-for="IdProf" />
        <div class="row">
            <div class="col-md-6 form-group">
                <label class="control-label">Persona</label>
                <input value="@Model.CcPer @Model.CcPerNavigation?.Nombre @Model.CcPerNavigation?.Apellido" class="form-control" disabled />
            </div>
            <div class="col-md-6 form-group">
                <label class="control-label">Profesión</label>
                <input value="@Model.IdProf @Model.IdProfNavigation?.Nom" class="form-control" disabled />
            </div>
            <div class="col-md-6 form-group">
                <label asp-for="Fecha" class="control-label">Fecha</label>
                <input asp-for="Fecha" type="date" class="form-control" />
                <span asp-validation-for="Fecha" class="text-danger"></span>
            </div>
            <div class="col-md-6 form-group">
                <label asp-for="Univer" class="control-label">Universidad</label>
                <input asp-for="Univer" class="form-control" maxlength="50" />
                <span asp-validation-for="Univer" class="text-danger"></span>
            </div>
        </div>
        <div class="form-actions">
            <input type="submit" value="Guardar" class="btn btn-primary" />
            <a class="btn btn-ghost" asp-action="Index">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
