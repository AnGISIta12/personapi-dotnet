@model personapi_dotnet.Models.Entities.Estudio

@{
    ViewData["Title"] = "Eliminar estudio";
}

<a class="crumb reveal" asp-action="Index"><i class="ph ph-arrow-left"></i>Volver a estudios</a>

<div class="surface detail-card danger-card reveal" style="--i:1">
    <div class="warning">
        <i class="ph ph-warning"></i>
        <div>
            <strong>¿Seguro que quieres eliminar este estudio?</strong>
            <span>Esta acción no se puede deshacer.</span>
        </div>
    </div>
    <dl class="detail-list">
        <div class="detail-item">
            <dt>Persona</dt>
            <dd>@Model.CcPer - @Model.CcPerNavigation.Nombre @Model.CcPerNavigation.Apellido</dd>
        </div>
        <div class="detail-item">
            <dt>Profesión</dt>
            <dd>@Model.IdProf - @Model.IdProfNavigation.Nom</dd>
        </div>
        <div class="detail-item">
            <dt>Fecha</dt>
            <dd>@Model.Fecha?.ToString("yyyy-MM-dd")</dd>
        </div>
        <div class="detail-item">
            <dt>Universidad</dt>
            <dd>@Html.DisplayFor(model => model.Univer)</dd>
        </div>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" name="idProf" value="@Model.IdProf" />
        <input type="hidden" name="ccPer" value="@Model.CcPer" />
        <div class="form-actions">
            <input type="submit" value="Eliminar" class="btn btn-danger" />
            <a class="btn btn-ghost" asp-action="Index">Cancelar</a>
        </div>
    </form>
</div>
