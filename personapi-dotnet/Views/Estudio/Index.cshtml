@model IEnumerable<personapi_dotnet.Models.Entities.Estudio>

@{
    ViewData["Title"] = "Estudios";
}

<div class="page-head reveal">
    <div>
        <h1>Estudios</h1>
        <p class="lede">Las profesiones que ha estudiado cada persona. Desde aquí puedes ver, editar o eliminar cada registro.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create"><i class="ph ph-plus"></i>Crear nuevo</a>
</div>
<div class="surface reveal" style="--i:1">
    @if (!Model.Any())
    {
        <div class="empty">
            <i class="ph ph-graduation-cap"></i>
            <h3>Aún no hay estudios</h3>
            <p>Registra el primer estudio para relacionar una persona con su profesión.</p>
            <a class="btn btn-primary" asp-action="Create"><i class="ph ph-plus"></i>Crear estudio</a>
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table class="table app-table">
                <thead>
                    <tr>
                        <th>Persona</th>
                        <th>Profesión</th>
                        <th>Fecha</th>
                        <th>Universidad</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
            @foreach (var item in Model) {
                    <tr>
                        <td>@item.CcPer - @item.CcPerNavigation.Nombre @item.CcPerNavigation.Apellido</td>
                        <td><span class="tag green">@item.IdProfNavigation.Nom</span></td>
                        <td>@item.Fecha?.ToString("yyyy-MM-dd")</td>
                        <td>@Html.DisplayFor(modelItem => item.Univer)</td>
                        <td class="text-end-cell">
                            <span class="row-actions">
                                <a class="row-action" asp-action="Edit" asp-route-idProf="@item.IdProf" asp-route-ccPer="@item.CcPer"><i class="ph ph-pencil-simple"></i>Editar</a>
                                <a class="row-action" asp-action="Details" asp-route-idProf="@item.IdProf" asp-route-ccPer="@item.CcPer"><i class="ph ph-eye"></i>Detalles</a>
                                <a class="row-action danger" asp-action="Delete" asp-route-idProf="@item.IdProf" asp-route-ccPer="@item.CcPer"><i class="ph ph-trash"></i>Eliminar</a>
                            </span>
                        </td>
                    </tr>
            }
                </tbody>
            </table>
        </div>
    }
</div>
