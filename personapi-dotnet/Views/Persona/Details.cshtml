@model personapi_dotnet.Models.Entities.Persona

@{
    ViewData["Title"] = "Detalles";
}

<h1>Detalles</h1>

<div>
    <h4>Persona</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Cedula</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Cc)</dd>
        <dt class="col-sm-2">Nombre</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Nombre)</dd>
        <dt class="col-sm-2">Apellido</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Apellido)</dd>
        <dt class="col-sm-2">Genero</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Genero)</dd>
        <dt class="col-sm-2">Edad</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Edad)</dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model.Cc">Editar</a> |
    <a asp-action="Index">Volver a la lista</a>
</div>
