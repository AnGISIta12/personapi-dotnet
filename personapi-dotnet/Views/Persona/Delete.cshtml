@model personapi_dotnet.Models.Entities.Persona

@{
    ViewData["Title"] = "Eliminar persona";
}

<a class="crumb reveal" asp-action="Index"><i class="ph ph-arrow-left"></i>Volver a personas</a>

<div class="surface detail-card danger-card reveal" style="--i:1">
    <div class="warning">
        <i class="ph ph-warning"></i>
        <div>
            <strong>¿Seguro que quieres eliminar a esta persona?</strong>
            <span>También se borrarán sus teléfonos y estudios. Esta acción no se puede deshacer.</span>
        </div>
    </div>
    <dl class="detail-list">
        <div class="detail-item">
            <dt>Cédula</dt>
            <dd>@Html.DisplayFor(model => model.Cc)</dd>
        </div>
        <div class="detail-item">
            <dt>Nombre</dt>
            <dd>@Html.DisplayFor(model => model.Nombre)</dd>
        </div>
        <div class="detail-item">
            <dt>Apellido</dt>
            <dd>@Html.DisplayFor(model => model.Apellido)</dd>
        </div>
        <div class="detail-item">
            <dt>Género</dt>
            <dd>@Html.DisplayFor(model => model.Genero)</dd>
        </div>
        <div class="detail-item">
            <dt>Edad</dt>
            <dd>@Html.DisplayFor(model => model.Edad)</dd>
        </div>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" name="id" value="@Model.Cc" />
        <div class="form-actions">
            <input type="submit" value="Eliminar" class="btn btn-danger" />
            <a class="btn btn-ghost" asp-action="Index">Cancelar</a>
        </div>
    </form>
</div>
