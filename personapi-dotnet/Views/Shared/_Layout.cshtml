@{
    // para resaltar el enlace activo del menu
    var seccionActual = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PersonaAPI</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap" />
    <link rel="stylesheet" href="https://unpkg.com/@@phosphor-icons/web@@2.1.1/src/regular/style.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/personapi-dotnet.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="app-nav">
        <nav class="navbar navbar-expand-md">
            <div class="container">
                <a class="navbar-brand brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark"><i class="ph ph-identification-card"></i></span>
                    PersonaAPI
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Abrir menu">
                    <i class="ph ph-list"></i>
                </button>
                <div class="navbar-collapse collapse" id="navbarSupportedContent">
                    <ul class="navbar-nav flex-grow-1 align-items-md-center">
                        <li class="nav-item">
                            <a class="nav-link @(seccionActual == "Home" ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Index"><i class="ph ph-house"></i>Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(seccionActual == "Persona" ? "active" : "")" asp-area="" asp-controller="Persona" asp-action="Index"><i class="ph ph-users"></i>Personas</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(seccionActual == "Profesion" ? "active" : "")" asp-area="" asp-controller="Profesion" asp-action="Index"><i class="ph ph-briefcase"></i>Profesiones</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(seccionActual == "Estudio" ? "active" : "")" asp-area="" asp-controller="Estudio" asp-action="Index"><i class="ph ph-graduation-cap"></i>Estudios</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(seccionActual == "Telefono" ? "active" : "")" asp-area="" asp-controller="Telefono" asp-action="Index"><i class="ph ph-phone"></i>Teléfonos</a>
                        </li>
                        <li class="nav-item ms-md-auto">
                            <a class="nav-link nav-api" href="~/swagger"><i class="ph ph-brackets-curly"></i>API Swagger</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container app-main">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="footer">
        <div class="container">
            <span>&copy; 2026 PersonaAPI. Laboratorio 1 de Arquitectura de Software.</span>
            <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacidad</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
